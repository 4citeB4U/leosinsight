NODE_ENV=development
PORT=8787
PUBLIC_APP_ORIGIN=http://localhost:5173

# Authentik / OIDC — identity establishment only; governed authorization remains LeeWay Security Harness responsibility
AUTHENTIK_ISSUER=https://auth.example.com/application/o/leos-insight/
AUTHENTIK_AUDIENCE=leos-insight
AUTHENTIK_JWKS_URI=https://auth.example.com/application/o/leos-insight/jwks/

# Nextcloud — collaboration / files only
NEXTCLOUD_BASE_URL=https://cloud.example.com
NEXTCLOUD_SERVICE_USER=
NEXTCLOUD_SERVICE_TOKEN=

# Jitsi — RTC transport only
JITSI_DOMAIN=meet.example.com
JITSI_APP_ID=leos-insight
JITSI_APP_SECRET=

# LeeWay canonical Forgejo-hosted runtime contracts — fill only after live authority is proven
LEEWAY_INGRESS_URL=
LEEWAY_PRODUCT_ID=leos-insight
LEEWAY_RUNTIME_AUTH_TOKEN=
LEEWAY_VERITAS_REQUIRED=true
LEEWAY_RECEIPTS_REQUIRED=true

# Product-to-LeeWay binding aliases. Values MUST be populated from the canonical Forgejo capability/contract authority.
# No guessed canonical capability identifiers are committed here.
LEEWAY_ROOM_JOIN_CAPABILITY=

# Roblox
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
